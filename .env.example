# API (Railway tingting-api)
DATABASE_URL=postgresql://user:pass@host:5432/railway
JWT_SECRET=change-me-to-random-32-chars-minimum
NODE_ENV=production
CORS_ORIGIN=*
# API 공개 주소 (사진 URL 생성에 사용, 없으면 요청 호스트 사용)
PUBLIC_API_URL=https://your-api-service.up.railway.app
# Railway Volume 마운트 경로 (사진 원본/편집본 저장)
UPLOADS_DIR=/data/uploads

# 앱 전용 키 — 앱의 EXPO_PUBLIC_APP_KEY와 같은 값 (없으면 누구나 접속 가능)
APP_KEY=change-me-to-random-string

# 우리 둘 — 서버 시작 시 없으면 이 이름으로 자동 생성 (이후 앱 설정에서 변경)
COUPLE_USER1_NAME=달팅이
COUPLE_USER2_NAME=알팅이
# 입장 비밀번호 초기값 — 비밀번호가 비어 있는 사용자에게만 적용 (이후 앱 설정에서 변경)
COUPLE_INITIAL_PASSWORD=change-me

# 카카오 REST API 키 (developers.kakao.com > 앱 > 앱 키) — 장소 검색/주소 변환
KAKAO_REST_API_KEY=your-kakao-rest-api-key

# 마이박스 개인 액세스 토큰 (developers.mybox.naver.com) — 설정하면 사진을 마이박스에 백업
MYBOX_TOKEN=
# 토큰 만료일 (YYYY-MM-DD) — 설정 화면에 D-day 표시
# MYBOX_TOKEN_EXPIRES=
# MYBOX_FOLDER_NAME=TingTing 사진 백업

# Mobile (EAS 빌드 시 주입)
EXPO_PUBLIC_API_URL=https://your-api-service.up.railway.app
EXPO_PUBLIC_APP_KEY=change-me-to-random-string
# EAS Update (GitHub Actions) — repo Secrets에 EXPO_TOKEN 설정
# https://expo.dev/accounts/[account]/settings/access-tokens
