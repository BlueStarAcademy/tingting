{
  "expo": {
    "name": "TingTing",
    "slug": "tingting",
    "scheme": "tingting",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FDC1BF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bluestaracademy.tingting",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "nmap",
          "kakaomap",
          "kakaonavi",
          "tmap"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FDC1BF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.bluestaracademy.tingting",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACTIVITY_RECOGNITION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "static"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/69501247-adff-48eb-9eba-c424ddd9b5f0",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "react-native-maps",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "지도에서 지금 우리 위치를 보여주기 위해 위치 정보가 필요해요."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "여행 사진을 앨범에 올리고 편집하기 위해 사진 접근이 필요해요.",
          "cameraPermission": "여행 사진을 찍기 위해 카메라 접근이 필요해요."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "휴대폰 앨범의 사진을 보고 편집·정리하고 팅팅에 올리기 위해 사진 접근이 필요해요.",
          "savePhotosPermission": "편집한 사진을 휴대폰 갤러리에 저장하기 위해 접근이 필요해요.",
          "granularPermissions": ["photo"]
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "뷰티 카메라로 사진을 찍기 위해 카메라 접근이 필요해요.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "69501247-adff-48eb-9eba-c424ddd9b5f0"
      }
    }
  }
}
